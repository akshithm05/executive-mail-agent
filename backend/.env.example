# ---- Application ------------------------------------------------------------
APP_NAME=AI Executive Email Assistant
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
GIT_SHA=unknown

# ---- HTTP / CORS ------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000
REQUEST_ID_HEADER=X-Request-ID

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# json (production) | console (local development)
LOG_FORMAT=console

# ---- Database ---------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_USER=aeea
DB_PASSWORD=aeea
DB_NAME=aeea
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---- Google OAuth -------------------------------------------------------
# Register an OAuth 2.0 client (type: Web application) in Google Cloud
# Console > APIs & Services > Credentials. Add the redirect URI below to the
# client's "Authorized redirect URIs", and enable the Gmail API for the
# project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.labels,https://www.googleapis.com/auth/calendar.events

# ---- Gmail API client -----------------------------------------------------
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GMAIL_REQUEST_TIMEOUT_SECONDS=15
GMAIL_MAX_RETRIES=5
GMAIL_REQUESTS_PER_SECOND=5
GMAIL_BURST_CAPACITY=10

# ---- Google Calendar API client ---------------------------------------------
CALENDAR_API_BASE_URL=https://www.googleapis.com/calendar/v3
CALENDAR_REQUEST_TIMEOUT_SECONDS=15
CALENDAR_MAX_RETRIES=5
CALENDAR_REQUESTS_PER_SECOND=5
CALENDAR_BURST_CAPACITY=10

# ---- APScheduler job cadence ------------------------------------------------
SCHEDULER_REMINDER_POLL_INTERVAL_SECONDS=60
SCHEDULER_CALENDAR_SYNC_INTERVAL_SECONDS=300
SCHEDULER_MEMORY_DECAY_INTERVAL_HOURS=24

# ---- AI (Claude) email-triage agent ----------------------------------------
# Get a key at https://console.anthropic.com/. Leave unset to disable the
# agent -- ingestion and the API still work; queued jobs are skipped with a
# warning log instead of erroring (see app/agents/email_agent.py).
AI_ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=60

# ---- Long-term memory subsystem --------------------------------------------
# embedding_provider="hashing" is a local, dependency-free embedding (no API
# key, no network call) -- see app/agents/embeddings.py. Swap to a real
# vector-embedding provider later purely via this setting.
MEMORY_EMBEDDING_PROVIDER=hashing
MEMORY_EMBEDDING_DIMENSIONS=256
MEMORY_DECAY_HALF_LIFE_DAYS=30
MEMORY_RETRIEVAL_TOP_K=6
MEMORY_SUMMARIZATION_THRESHOLD=20

# ---- Security / token encryption ------------------------------------------
# Fernet key protecting Google access/refresh tokens at rest. Left unset here
# on purpose: an env var set to an empty string is NOT the same as unset (it
# would override Settings' built-in dev-only default with "", which fails at
# startup since "" isn't a valid Fernet key). Leaving this line commented out
# lets the dev-only default apply for local/test use.
# Generate a real one per environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECURITY_TOKEN_ENCRYPTION_KEY=

# ---- First-party session cookie -------------------------------------------
SESSION_COOKIE_NAME=aeea_session
SESSION_TTL_SECONDS=1209600
# false for local http development; MUST be true in production (https only).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Optional: where /auth/google/callback redirects after login (e.g. a
# frontend URL). Leave empty to have the callback return the user's profile
# as JSON instead -- useful for testing the API directly.
SESSION_POST_LOGIN_REDIRECT_URL=

# ---- Redis (caching + distributed rate limiting) ---------------------------
# Optional infrastructure -- every consumer fails open if Redis is
# unreachable (see app/infra/cache.py). Also backs the scheduler's
# leader-election lock so only one replica's background jobs actually fire
# (see app/infra/leader_lock.py).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_DEFAULT_TTL_SECONDS=60

# ---- Inbound API rate limiting ----------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_WINDOW=120
RATE_LIMIT_WINDOW_SECONDS=60

# ---- CSRF protection (double-submit cookie) --------------------------------
CSRF_ENABLED=true
CSRF_COOKIE_NAME=aeea_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_TTL_SECONDS=1209600

# ---- Sentry error tracking --------------------------------------------------
# Get a DSN at https://sentry.io/. Leave unset to disable entirely (default).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ---- OpenTelemetry distributed tracing --------------------------------------
# Point at an OTLP collector (e.g. Grafana Tempo, Jaeger, Honeycomb) to
# enable. Leave unset to disable entirely (default).
OTEL_SERVICE_NAME=aeea-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
